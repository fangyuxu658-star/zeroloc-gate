{
  "name": "zeroloc-gate",
  "version": "0.1.0-beta.1",
  "private": true,
  "description": "Local-first localization quality gate with optional ecosystem adapters",
  "type": "module",
  "bin": {
    "zeroloc": "./bin/zeroloc.mjs"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "check:example": "node bin/zeroloc.mjs check --source examples/locales/en.json --targets examples/locales/de.json,examples/locales/fr.json,examples/locales/ja.json",
    "check:json": "node bin/zeroloc.mjs check --source examples/locales/en.json --targets examples/locales/de.json,examples/locales/fr.json,examples/locales/ja.json --format json",
    "test:visual": "node qa/run.mjs",
    "demo": "node demo/server.mjs",
    "licenses": "node scripts/licenses.mjs",
    "licenses:check": "node scripts/licenses.mjs --check",
    "sbom": "npm sbom --sbom-format cyclonedx"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "@formatjs/icu-messageformat-parser": "3.5.21",
    "fast-json-patch": "3.1.1"
  },
  "optionalDependencies": {
    "i18next-cli": "1.77.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "axe-core": "4.14.0",
    "i18next": "26.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
